# INERT TEMPLATE: not executed from packaging/pypi.
# Proposed new manual publisher: publish-selected.yml. Never reactivate the consumed publish.yml.
# Separate review and explicit owner approval are required before any activation.
name: Publish selected PyRORB release

on:
  workflow_dispatch:
    inputs:
      release_tag:
        description: Existing lightweight calendar release tag at the reviewed main commit
        required: true
        type: string
      source_sha:
        description: Exact reviewed current main commit SHA
        required: true
        type: string
      quality_run_id:
        description: Successful main-push Windows quality run ID for that commit
        required: true
        type: string

permissions: {}

concurrency:
  group: pyrorb-pypi-publication
  cancel-in-progress: false

jobs:
  build:
    if: >-
      github.repository == 'Chain-Frost/pyrorb' &&
      github.ref == 'refs/heads/main' &&
      github.event_name == 'workflow_dispatch' &&
      github.run_attempt == 1 &&
      vars.PYPI_PUBLISH_ENABLED == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      actions: read
    outputs:
      artifact_id: ${{ steps.distributions.outputs.artifact-id }}
    env:
      RELEASE_TAG: ${{ inputs.release_tag }}
      SOURCE_SHA: ${{ inputs.source_sha }}
      QUALITY_RUN_ID: ${{ inputs.quality_run_id }}
    defaults:
      run:
        shell: bash --noprofile --norc -euo pipefail {0}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7, reviewed 2026-11-22
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7, reviewed 2026-11-22
        with:
          python-version: '3.13'
      - name: Check exact main, successful selected main quality run and release tag
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          [[ "$SOURCE_SHA" =~ ^[0-9a-f]{40}$ ]]
          [[ "$QUALITY_RUN_ID" =~ ^[1-9][0-9]*$ ]]
          [[ "$RELEASE_TAG" =~ ^v[0-9]{2}\.[0-9]{1,2}\.[0-9]{1,2}\.[1-9][0-9]*$ ]]
          test "$SOURCE_SHA" = "$GITHUB_SHA"
          test "$(git rev-parse HEAD)" = "$SOURCE_SHA"
          test "$(gh api "repos/$GITHUB_REPOSITORY/git/ref/heads/main" --jq '.object.sha')" = "$SOURCE_SHA"
          test "$(gh api "repos/$GITHUB_REPOSITORY/git/ref/tags/$RELEASE_TAG" --jq 'select(.object.type == "commit") | .object.sha')" = "$SOURCE_SHA"
          gh api "repos/$GITHUB_REPOSITORY/actions/runs/$QUALITY_RUN_ID" > "$RUNNER_TEMP/quality-run.json"
          gh api --paginate "repos/$GITHUB_REPOSITORY/actions/runs/$QUALITY_RUN_ID/jobs?filter=latest&per_page=100" \
            | jq -s '[.[].jobs[]]' > "$RUNNER_TEMP/quality-jobs.json"
          jq -e --arg sha "$SOURCE_SHA" --arg repo "$GITHUB_REPOSITORY" \
            '.head_sha == $sha and .head_branch == "main" and .event == "push" and
             .path == ".github/workflows/quality.yml" and .head_repository.full_name == $repo and
             .repository.full_name == $repo and .status == "completed" and .conclusion == "success"' \
            "$RUNNER_TEMP/quality-run.json"
          for name in 'windows-python-versions (3.11)' 'windows-python-versions (3.14)' 'windows-python-313'; do
            jq -e --arg name "$name" \
              '[.[] | select(.name == $name)] | length == 1 and .[0].conclusion == "success"' \
              "$RUNNER_TEMP/quality-jobs.json"
          done
          test "$(gh api "repos/$GITHUB_REPOSITORY/environments/pypi" --jq \
            '([.protection_rules[]? | select(.type == "required_reviewers") | .reviewers[]?] | length) == 1 and ([.protection_rules[]? | select(.type == "required_reviewers") | .reviewers[]? | select(.type == "User" and .reviewer.login == "Chain-Frost")] | length) == 1 and (.can_admins_bypass == false) and (.deployment_branch_policy.protected_branches == false) and (.deployment_branch_policy.custom_branch_policies == true)')" = true
          test "$(gh api "repos/$GITHUB_REPOSITORY/environments/pypi/deployment-branch-policies?per_page=100" --jq \
            '.total_count == 1 and (.branch_policies | length) == 1 and .branch_policies[0].name == "main" and .branch_policies[0].type == "branch"')" = true
          python -m pip install build packaging twine
          python - <<'PY'
          import json
          import os
          import urllib.request
          from packaging.version import Version
          with urllib.request.urlopen("https://pypi.org/pypi/pyrorb/json", timeout=30) as response:
              project = json.load(response)
          selected = Version(os.environ["RELEASE_TAG"].removeprefix("v"))
          if project["info"]["name"].lower() != "pyrorb" or "26.11.24.1" not in project["releases"]:
              raise SystemExit("Existing PyRORB project identity not confirmed")
          if any(selected <= Version(released) for released in project["releases"]):
              raise SystemExit("Selected version must be strictly later than all published versions")
          PY
      - name: Run existing pure-Python quality and source checks
        run: |
          python -m pip install -r requirements-catg.txt -e '.[dev]'
          python repo-scripts/check_local.py
          mkdir "$RUNNER_TEMP/pyrorb-receipts"
          python repo-scripts/cmd_public_probe.py > "$RUNNER_TEMP/pyrorb-receipts/source-cmd.json"
          cp "$RUNNER_TEMP/quality-run.json" "$RUNNER_TEMP/quality-jobs.json" "$RUNNER_TEMP/pyrorb-receipts/"
      - name: Stamp selected version only in the temporary build checkout
        run: |
          python repo-scripts/auto_release_version.py stamp "$RELEASE_TAG"
          python repo-scripts/check_release.py --tag="$RELEASE_TAG"
      - name: Build and inspect the exact distribution pair
        run: |
          python -m build --outdir "$RUNNER_TEMP/pyrorb-dist"
          python -m twine check --strict "$RUNNER_TEMP/pyrorb-dist/"*
          python repo-scripts/check_release.py --tag="$RELEASE_TAG" --dist "$RUNNER_TEMP/pyrorb-dist"
          sha256sum "$RUNNER_TEMP/pyrorb-dist/"* > "$RUNNER_TEMP/pyrorb-receipts/SHA256SUMS"
          printf 'source=%s\ntag=%s\n' "$GITHUB_SHA" "$RELEASE_TAG" > "$RUNNER_TEMP/pyrorb-receipts/source.txt"
          python -VV > "$RUNNER_TEMP/pyrorb-receipts/python.txt"
          python -m pip freeze > "$RUNNER_TEMP/pyrorb-receipts/build-environment.txt"
      - name: Install wheel and sdist independently outside the checkout
        run: |
          # First resolve the published package dependencies; install the
          # separately pinned PR-only CATG writer only after the base install.
          wheel_files=("$RUNNER_TEMP/pyrorb-dist/"*.whl)
          for kind in wheel sdist; do
            if [ "$kind" = wheel ]; then
              files=("$RUNNER_TEMP/pyrorb-dist/"*.whl)
            else
              files=("$RUNNER_TEMP/pyrorb-dist/"*.tar.gz)
            fi
            python -m venv "$RUNNER_TEMP/pyrorb-$kind"
            installed_python="$RUNNER_TEMP/pyrorb-$kind/bin/python"
            "$installed_python" -m pip install "${files[0]}"
            "$installed_python" -m pip check
            (
              cd "$RUNNER_TEMP"
              "$installed_python" -I -c "import importlib.util; assert importlib.util.find_spec('pyromb') is None; assert importlib.util.find_spec('ryan_library') is None; from runoff_routing.tuflow_rainfall import export_tuflow_rainfall; from runoff_routing.rorb_readers.output_reader import bind_output_site_columns"
              "$installed_python" -I -m runoff_routing.tuflow_rainfall --help
            )
            "$installed_python" -m pip install "${files[0]}[mcp,dev,research]"
            "$installed_python" -m pip check
            "$installed_python" -m pip install -r "$GITHUB_WORKSPACE/requirements-catg.txt"
            "$installed_python" -m pip check
            "$installed_python" -I -c "from pyromb.models.rorb import render_ordered_catg; assert callable(render_ordered_catg)"
            (
              cd "$RUNNER_TEMP"
              "$installed_python" -I - "${wheel_files[0]}" <<'PY' > "$RUNNER_TEMP/pyrorb-receipts/$kind-install.txt"
          import importlib.metadata
          import os
          import platform
          import sys
          from pathlib import Path
          import runoff_routing
          from runoff_routing.engine_provenance import identify_implementation, verify_installed_wheel

          origin = Path(runoff_routing.__file__).resolve()
          if not origin.is_relative_to(Path(sys.prefix).resolve()):
              raise SystemExit(f"Package is not isolated in the installed environment: {origin}")
          version = importlib.metadata.version("pyrorb")
          if f"v{version}" != os.environ["RELEASE_TAG"]:
              raise SystemExit(f"Installed version does not match the selected release: {version}")
          if not (origin.parent / "py.typed").is_file():
              raise SystemExit("Installed typing marker is missing")
          print(f"Verified installed distribution {version}: {origin}")
          print(f"Wheel matching installed source SHA-256: {verify_installed_wheel(Path(sys.argv[1]))}")
          print(f"Package-code identity: {identify_implementation().revision}")
          print(f"Interpreter: {sys.version}; platform: {platform.platform()}")
          PY
            )
            cat "$RUNNER_TEMP/pyrorb-receipts/$kind-install.txt"
            "$installed_python" -m pip freeze > "$RUNNER_TEMP/pyrorb-receipts/$kind-environment.txt"
          done
          (
            cd "$RUNNER_TEMP"
            "$RUNNER_TEMP/pyrorb-wheel/bin/python" -I "$GITHUB_WORKSPACE/repo-scripts/cmd_public_probe.py" \
              > "$RUNNER_TEMP/pyrorb-receipts/wheel-cmd.json"
          )
          # The existing probe emits stable full per-case JSON, including code
          # identity, Q/scalar/status results and preserved incomplete outcomes.
          cmp "$RUNNER_TEMP/pyrorb-receipts/source-cmd.json" "$RUNNER_TEMP/pyrorb-receipts/wheel-cmd.json"
      - name: Retain review receipts
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: pyrorb-release-receipts
          path: ${{ runner.temp }}/pyrorb-receipts/
          if-no-files-found: error
          retention-days: 30
      - name: Transfer checked distributions
        id: distributions
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: pyrorb-distributions
          path: ${{ runner.temp }}/pyrorb-dist/
          if-no-files-found: error
          retention-days: 30

  publish:
    needs: build
    if: >-
      github.repository == 'Chain-Frost/pyrorb' &&
      github.ref == 'refs/heads/main' &&
      github.event_name == 'workflow_dispatch' &&
      github.run_attempt == 1 &&
      vars.PYPI_PUBLISH_ENABLED == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment:
      name: pypi
      url: https://pypi.org/p/PyRORB
    permissions:
      contents: read
      actions: read
      id-token: write
    env:
      SOURCE_SHA: ${{ inputs.source_sha }}
      RELEASE_TAG: ${{ inputs.release_tag }}
      QUALITY_RUN_ID: ${{ inputs.quality_run_id }}
    steps:
      # No source checkout, dependency installation or build in the OIDC job.
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          artifact-ids: ${{ needs.build.outputs.artifact_id }}
          path: dist/
          merge-multiple: true
          digest-mismatch: error
      - name: Recheck protected deployment, source, tag and unused existing-project version
        env:
          GH_TOKEN: ${{ github.token }}
        shell: bash --noprofile --norc -euo pipefail {0}
        run: |
          test "$SOURCE_SHA" = "$GITHUB_SHA"
          test "$(gh api "repos/$GITHUB_REPOSITORY/git/ref/heads/main" --jq '.object.sha')" = "$SOURCE_SHA"
          test "$(gh api "repos/$GITHUB_REPOSITORY/git/ref/tags/$RELEASE_TAG" --jq 'select(.object.type == "commit") | .object.sha')" = "$SOURCE_SHA"
          test "$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$QUALITY_RUN_ID" --jq '.conclusion')" = success
          test "$(gh api "repos/$GITHUB_REPOSITORY/environments/pypi" --jq \
            '([.protection_rules[]? | select(.type == "required_reviewers") | .reviewers[]?] | length) == 1 and ([.protection_rules[]? | select(.type == "required_reviewers") | .reviewers[]? | select(.type == "User" and .reviewer.login == "Chain-Frost")] | length) == 1 and (.can_admins_bypass == false) and (.deployment_branch_policy.protected_branches == false) and (.deployment_branch_policy.custom_branch_policies == true)')" = true
          test "$(gh api "repos/$GITHUB_REPOSITORY/environments/pypi/deployment-branch-policies?per_page=100" --jq \
            '.total_count == 1 and (.branch_policies | length) == 1 and .branch_policies[0].name == "main" and .branch_policies[0].type == "branch"')" = true
          python - <<'PY'
          import json
          import os
          import urllib.request
          version = os.environ["RELEASE_TAG"].removeprefix("v")
          # Existing project only. A 404, incomplete inventory or network error fails closed.
          with urllib.request.urlopen("https://pypi.org/pypi/pyrorb/json", timeout=30) as response:
              project = json.load(response)
          if project["info"]["name"].lower() != "pyrorb" or "26.11.24.1" not in project["releases"]:
              raise SystemExit("Existing PyRORB project identity not confirmed")
          if version in project["releases"]:
              raise SystemExit("Release version already exists; no overwrite or partial retry")
          PY
      - name: Publish reviewed artifacts using the configured Trusted Publisher
        uses: pypa/gh-action-pypi-publish@7245906fb61fa33a13554f9d5fb856fe61758086 # v1.14.3
        with:
          packages-dir: dist/
          skip-existing: 'false'
          attestations: 'true'

  release:
    needs: publish
    if: needs.publish.result == 'success'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
    env:
      SOURCE_SHA: ${{ inputs.source_sha }}
      RELEASE_TAG: ${{ inputs.release_tag }}
    steps:
      - name: Publish GitHub release notes after successful PyPI upload
        uses: actions/github-script@ed597411d8f924073f98dfc5c65a23a2325f34cd # v8
        with:
          script: |
            const {owner, repo} = context.repo;
            const sha = process.env.SOURCE_SHA;
            const tag = process.env.RELEASE_TAG;
            const ref = (await github.rest.git.getRef({owner,repo,ref:'tags/' + tag})).data;
            if (ref.object.type !== 'commit' || ref.object.sha !== sha) {
              throw new Error('Release tag moved after acceptance; investigate uploaded artifacts.');
            }
            await github.rest.repos.createRelease({
              owner,repo,tag_name:tag,target_commitish:sha,name:tag,
              draft:false,prerelease:false,generate_release_notes:true,
              body:'Selected bounded PyRORB software release. See supported-feature and native/scientific qualification records; this is not blanket scientific acceptance.'
            });
